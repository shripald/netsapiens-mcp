# =============================================================================
# NetSapiens MCP — PressONE settings (template, no real values)
#
# Local use with Claude Desktop (stdio mode): these values go in the "env"
# block of claude_desktop_config.json, not in a file in this repo.
# Hosted use: copy to .env (already git-ignored). Never commit real secrets.
# =============================================================================

# --- Always ---
NETSAPIENS_API_URL=https://api.pressone.net

# --- Local (stdio) login: choose ONE option ---

# Option A: an API key (simplest). Acts as whoever owns the key.
NETSAPIENS_API_TOKEN=

# Option B: OAuth client + a NetSapiens user login. All four are required.
# If these are set, they win over NETSAPIENS_API_TOKEN.
# NETSAPIENS_OAUTH_CLIENT_ID=
# NETSAPIENS_OAUTH_CLIENT_SECRET=
# NETSAPIENS_OAUTH_USERNAME=           # e.g. 1000@pressone.net
# NETSAPIENS_OAUTH_PASSWORD=

# --- Recommended safety settings ---
MCP_CONFIRM_DESTRUCTIVE=true           # ask in Claude before anything destructive
MCP_DISABLED_TOOLS=delete_*,remove_*   # hide delete/remove tools entirely
# MCP_READ_ONLY=true                   # uncomment for a look-only server

# --- Hosted (http) mode only; see HOSTING-PRESSONE.md ---
# MCP_TRANSPORT=http
# MCP_BASE_URL=https://mcp.pressone.net
# NETSAPIENS_OAUTH_CLIENT_ID=
# NETSAPIENS_OAUTH_CLIENT_SECRET=
# MCP_SESSION_SECRET=                  # 64 random hex chars: openssl rand -hex 32
# MCP_STATELESS=false                  # keeps the confirm prompt working
# MCP_LOGIN_HEADER=PressONE AI: Sign In
# MCP_SERVER_TITLE=PressONE NetSapiens
# MCP_ICON_URL=https://pressone.net/path/to/logo.png
# MCP_WEBSITE_URL=https://pressone.net
# MCP_CORS_ORIGIN=https://claude.ai
